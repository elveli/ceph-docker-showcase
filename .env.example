# Copy to .env to override defaults. Both compose.yaml and the scripts read it.

# Host ports (bound to 127.0.0.1 only)
DASHBOARD_PORT=18443
RGW_PORT=17480
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

# /24 used by the compose network; mons get .11-.13. Changing this after the
# first `make up` requires `make clean` (the monmap stores the mon IPs).
CEPH_NET_PREFIX=10.250.0

# Image pins
CEPH_IMAGE=quay.io/ceph/ceph:v20.2.5@sha256:4337ac8ac81d40df136e5eac92ca53bb52360a5e039f3d1f7935e729eb5ef42c
AWS_CLI_IMAGE=amazon/aws-cli:2.39.0
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.2.5

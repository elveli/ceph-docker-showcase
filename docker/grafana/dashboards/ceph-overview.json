    {
      "id": 12,
      "type": "timeseries",
      "title": "Throughput by pool",
      "description": "Writes above zero, reads below. From the mgr prometheus module's per-pool counters.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(ceph_pool_wr_bytes[1m]) * on(pool_id) group_left(name) ceph_pool_metadata)",
          "legendFormat": "write {{name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "-sum by (name) (rate(ceph_pool_rd_bytes[1m]) * on(pool_id) group_left(name) ceph_pool_metadata)",
          "legendFormat": "read {{name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      }
